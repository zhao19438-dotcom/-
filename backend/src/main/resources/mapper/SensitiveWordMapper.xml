<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cainiao.forum.dao.SensitiveWordMapper">
  <!-- 敏感词字段映射。 -->
  <resultMap id="BaseResultMap" type="com.cainiao.forum.model.SensitiveWord">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="word" jdbcType="VARCHAR" property="word" />
    <result column="createTime" jdbcType="TIMESTAMP" property="createTime" />
  </resultMap>

  <sql id="Base_Column_List">
    id, word, createTime
  </sql>

  <!-- 查询全部敏感词。 -->
  <select id="selectAll" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List" />
    from t_sensitive_word
    order by id desc
  </select>

  <!-- 只查询词内容，供内存词库构建。 -->
  <select id="selectAllWords" resultType="java.lang.String">
    select word from t_sensitive_word
  </select>

  <!-- 新增敏感词。 -->
  <insert id="insertSelective" parameterType="com.cainiao.forum.model.SensitiveWord" useGeneratedKeys="true" keyProperty="id">
    insert into t_sensitive_word
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="word != null">
        word,
      </if>
      <if test="createTime != null">
        createTime,
      </if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      <if test="word != null">
        #{word,jdbcType=VARCHAR},
      </if>
      <if test="createTime != null">
        #{createTime,jdbcType=TIMESTAMP},
      </if>
    </trim>
  </insert>

  <!-- 删除敏感词。 -->
  <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
    delete from t_sensitive_word
    where id = #{id,jdbcType=BIGINT}
  </delete>
</mapper>
